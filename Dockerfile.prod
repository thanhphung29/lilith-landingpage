# syntax=docker/dockerfile:1

# ==========================================
# 1. Dependencies
# ==========================================
FROM node:26-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json ./
# Cache lại thư mục npm để không phải download lại package khi build
RUN npm ci --no-audit --no-fund


# ==========================================
# 2. Build
# ==========================================
FROM node:26-alpine AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

# 1
ARG NEXT_PUBLIC_GA_ID
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY

# 2
ENV NEXT_PUBLIC_GA_ID=$NEXT_PUBLIC_GA_ID
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Cache lại thư mục build của Next.js (.next/cache)
RUN npm run build


# ==========================================
# 3. Production runtime
# ==========================================
FROM node:26-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

# Run as non-root
USER node

# Copy only the files required at runtime
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/messages ./messages

EXPOSE 3000

CMD ["node", "server.js"]

